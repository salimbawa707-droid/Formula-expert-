# Copy this file to .env and fill in your own values.
# .env is git-ignored; .env.example is committed so the setup stays reproducible.

# --- Firebase web client (baked into the browser bundle at build time) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Only needed when the app uses a named Firestore database.
VITE_FIRESTORE_DATABASE_ID=

# --- Firebase App Check (see docs/APP_CHECK_SETUP.md) ---
# Site key of the reCAPTCHA key registered under Firebase Console > App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# recaptcha-enterprise (recommended) or recaptcha-v3
VITE_FIREBASE_APP_CHECK_PROVIDER=recaptcha-enterprise
# Leave empty in production. Local development only: paste the debug token from
# the browser console the first time App Check runs in dev.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
# Set to false only to switch App Check off temporarily.
VITE_FIREBASE_APP_CHECK_ENABLED=true

# --- Admin allow-lists (comma-separated, lower-case emails) ---
# VITE_ADMIN_EMAILS controls the Admin Console UI only (it is shipped to the
# browser). ADMIN_EMAILS is the server-side check used by the API.
VITE_ADMIN_EMAILS=owner@example.com
ADMIN_EMAILS=owner@example.com

# --- Server ---
PORT=3000
NODE_ENV=development
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
# Either inline JSON or a path to the service account file.
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
ALLOWED_ORIGINS=
APP_URL=
TRUST_PROXY=

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RESEARCH_MODEL=

# --- Google Play billing verification ---
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=

# --- Supabase (optional alternate auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
