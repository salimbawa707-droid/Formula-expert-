# Copy to .env for local development. Never put production secrets in source control.
PORT=3000
NODE_ENV=development

# Server-only AI key; keep this secret out of VITE_* variables.
GEMINI_API_KEY=

# Supabase Auth: VITE_* values are embedded in the client build; server values
# let protected Express routes verify Supabase access tokens with Supabase Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only Supabase service role key for verified account/data deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Native Android needs the deployed API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Server security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,capacitor://localhost
TRUST_PROXY=false

# Optional server credentials. Supply through a secret manager in production.
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
