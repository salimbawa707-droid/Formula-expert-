}

if (p2Phase13Summary.failed > 0) {
  console.log('Failed P2-13 Final Integrity tests:');
  p2Phase13Summary.results.filter(r => !r.passed).forEach(r => {
    console.log(`  [FAIL] ${r.testId} -> ${r.description}: ${r.message}`);
  });
}

