if (phSummary.failed > 0) {
  console.log('Failed pHEngine legacy tests:');
  phSummary.results.filter(r => !r.passed).forEach(r => {
    console.log(`  [FAIL] ${r.group} -> ${r.name}: ${r.message}`);
  });
}

if (phV2Summary.failed > 0) {
  console.log('Failed pH Engine v2 Reference tests:');
  phV2Summary.results.filter(r => !r.passed).forEach(r => {
    console.log(`  [FAIL] ${r.group} -> ${r.name}: ${r.message}`);
  });
}

