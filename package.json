{
  "name": "detergent-rnd-expert",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "clean": "node scripts/clean-build.mjs",
    "build:client": "vite build --configLoader runner",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "start": "node dist-server/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/utils/test-calculations.ts && tsx src/services/formulaIngredientResearchPipeline.test.ts && tsx src/services/ingredientResearchController.test.ts",
    "test:aggregate": "npm run typecheck && npm test",
    "build:android": "python3 scripts/build_release_apk.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^2.4.0",
    "@jridgewell/resolve-uri": "3.1.2",
    "@rdkit/rdkit": "^2026.3.6",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.21.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "googleapis": "^186.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smiles-drawer": "^2.4.1",
    "dexie": "^4.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=9.0.0"
  }
}
