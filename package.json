{
  "name": "formula-expert-forensic",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "build": "npx vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "test:phase6": "bun run scripts/run-p1-phase6-lab-evidence-regression.ts",
    "test": "bun run test:phase6",
    "test:all": "bun run src/utils/test-calculations.ts && bun run src/services/formulaIngredientResearchPipeline.test.ts && bun run src/services/ingredientResearchRouting.test.ts && bun run scripts/audit-hair-shampoo-removal.ts && bun run scripts/audit-full-master-ingredient-baseline.ts && bun run scripts/test-ingredient-applicability-review-matrix.ts",
    "test:db-migration": "node --import tsx src/db/database.migration.test.ts",
    "cap:sync": "cap sync android",
    "android:debug": "bun run cap:sync && node scripts/build_android_debug.mjs",
    "test:correction-static": "node scripts/verify-correction-static.mjs"
  },
  "dependencies": {
    "3dmol": "^2.5.5",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@google/genai": "^2.31.0",
    "@rdkit/rdkit": "^2026.9.1",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "googleapis": "^188.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "smiles-drawer": "^2.4.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.5",
    "@types/express": "^5.0.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
