    "@rdkit/rdkit": "^2026.3.6",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dexie": "^4.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
