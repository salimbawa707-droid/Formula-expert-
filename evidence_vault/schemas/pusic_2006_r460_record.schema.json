{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pušić 2006 Tables 5–8 source-extracted R460 reading",
  "type": "object",
  "required": [
    "source_id",
    "paper_citation",
    "publisher_url",
    "pdf_url",
    "printed_page",
    "table_number",
    "table_cell",
    "fabric",
    "detergent_form",
    "condition_label",
    "stain_or_control",
    "measurement_name",
    "measurement_value",
    "measurement_unit_status",
    "transcription_status"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_citation": {
      "type": "string",
      "minLength": 1
    },
    "publisher_url": {
      "type": "string",
      "format": "uri"
    },
    "pdf_url": {
      "type": "string",
      "format": "uri"
    },
    "printed_page": {
      "const": 13
    },
    "table_number": {
      "enum": [
        5,
        6,
        7,
        8
      ]
    },
    "table_cell": {
      "type": "string",
      "minLength": 1
    },
    "fabric": {
      "enum": [
        "cotton",
        "polyester_cotton_50_50"
      ]
    },
    "detergent_form": {
      "enum": [
        "powder",
        "liquid"
      ]
    },
    "condition_label": {
      "enum": [
        "before",
        "dose_1",
        "dose_2",
        "dose_3"
      ]
    },
    "dosage_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "dosage_unit": {
      "enum": [
        "g/kg",
        "mL/kg",
        null
      ]
    },
    "stain_or_control": {
      "enum": [
        "black_coffee",
        "red_wine",
        "cocoa",
        "blood",
        "pumpkin_seed_oil",
        "lipstick",
        "pureed_tomato",
        "shoe_cream",
        "standard_fabric_control"
      ]
    },
    "measurement_name": {
      "const": "R460_nm"
    },
    "measurement_value": {
      "type": "number"
    },
    "measurement_unit_status": {
      "const": "UNIT_UNSPECIFIED_IN_SOURCE_TABLE"
    },
    "transcription_status": {
      "enum": [
        "SOURCE_EXTRACTED_PENDING_SECOND_REVIEW",
        "SOURCE_BACKED"
      ]
    },
    "reviewer_1": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer_2": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_match": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "anomaly_flag": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
