export function calculateCommercialCapacity(input: {
  capacity: number | null;
  capacityBasis: CapacityBasis | null;
  activeMatterPercent: number | null;
}): {
  value: number | null;
  status: 'VALID' | 'INSUFFICIENT_DATA';
  reason?: string;
} {
  if (!isValidChelationCapacity(input.capacity)) {
    return {
      value: null,
      status: 'INSUFFICIENT_DATA',
      reason: 'CAPACITY_UNAVAILABLE'
    };
  }

  if (input.capacityBasis === 'COMMERCIAL_PRODUCT') {
    return {
      value: input.capacity,
      status: 'VALID'
    };
  }

  if (input.capacityBasis === 'ACTIVE_MATERIAL') {
    if (
      typeof input.activeMatterPercent !== 'number' ||
      !Number.isFinite(input.activeMatterPercent) ||
      input.activeMatterPercent <= 0 ||
      input.activeMatterPercent > 100
    ) {
      return {
        value: null,
        status: 'INSUFFICIENT_DATA',
        reason: 'ACTIVE_MATTER_REQUIRED'
      };
    }

    return {
      value:
        input.capacity *
        (input.activeMatterPercent / 100),
      status: 'VALID'
    };
  }

  return {
    value: null,
    status: 'INSUFFICIENT_DATA',
    reason: 'CAPACITY_BASIS_UNKNOWN'
  };
}

Use this shared function in every chelation calculation path.

