export function validateActiveMatter(
  input: ActiveMatterInput
): ActiveMatterValidation {
  const reasons: string[] = [];

  if (
    typeof input.value !== 'number' ||
    !Number.isFinite(input.value) ||
    input.value < 0 ||
    input.value > 100
  ) {
    return {
      value: null,
      status: 'INSUFFICIENT_DATA',
      provenance: input.provenance,
      verified: false,
      blockingReasons: ['ACTIVE_MATTER_VALUE_UNAVAILABLE_OR_INVALID']
    };
  }

  if (!input.ingredientId) {
    reasons.push('INGREDIENT_ID_REQUIRED');
  }

  if (
    input.provenance === 'UNKNOWN' ||
    input.provenance === 'UNAVAILABLE' ||
    input.provenance === 'ESTIMATED' ||
    input.provenance === 'MODEL_PREDICTED'
  ) {
    reasons.push('PROVENANCE_NOT_ELIGIBLE_FOR_VERIFIED_CALCULATION');
  }

  if (
    input.provenance === 'SUPPLIER_REPORTED' &&
    !input.evidenceId
  ) {
    reasons.push('SUPPLIER_EVIDENCE_REQUIRED');
  }

  if (
    input.provenance === 'MEASURED' &&
    !input.evidenceId
  ) {
    reasons.push('MEASUREMENT_EVIDENCE_REQUIRED');
  }

  if (reasons.length > 0) {
    return {
      value: input.value,
      status: 'INSUFFICIENT_DATA',
      provenance: input.provenance,
      verified: false,
      blockingReasons: reasons
    };
  }

  return {
    value: input.value,
    status: 'VALID',
    provenance: input.provenance,
    verified: true,
    blockingReasons: []
  };
}

IMPORTANT:
This is the basic input validator, not proof that a supplied evidence ID is genuine. Evidence IDs must also be checked against the actual evidence registry.

