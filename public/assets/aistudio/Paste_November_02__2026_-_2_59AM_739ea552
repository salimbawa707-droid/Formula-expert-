export function validateManufacturingAssay(
  record: ManufacturingAssayRecord
): {
  valid: boolean;
  status: 'COMPLETE' | 'INCOMPLETE' | 'INVALID';
  reasons: string[];
} {
  const reasons: string[] = [];

  if (
    typeof record.value !== 'number' ||
    !Number.isFinite(record.value) ||
    record.value < 0 ||
    record.value > 100
  ) {
    reasons.push('INVALID_ASSAY_VALUE');
  }

  if (!record.unit) reasons.push('UNIT_REQUIRED');
  if (!record.basis) reasons.push('BASIS_REQUIRED');
  if (!record.method) reasons.push('METHOD_REQUIRED');
  if (!record.sampleId) reasons.push('SAMPLE_ID_REQUIRED');
  if (!record.testedAt) reasons.push('TEST_DATE_REQUIRED');
  if (!record.laboratoryId) reasons.push('LABORATORY_REQUIRED');
  if (!record.analystId) reasons.push('ANALYST_REQUIRED');
  if (!record.evidenceId) reasons.push('EVIDENCE_REQUIRED');

  if (record.provenance !== 'MEASURED') {
    reasons.push('LAB_MEASURED_PROVENANCE_REQUIRED');
  }

  return {
    valid: reasons.length === 0,
    status: reasons.length === 0 ? 'COMPLETE' : 'INCOMPLETE',
    reasons
  };
}

