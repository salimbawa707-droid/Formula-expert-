rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin rights come only from an admins/{uid} document or a server-set
    // admin custom claim. No personal email address lives in these rules.
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.admin != null && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt', 'lastLoginAt'])
        && data.id is string && data.id == request.auth.uid && data.id.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    function isValidFormula(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'productType', 'grade', 'batchSizeKg', 'targetCost', 'targetPH', 'ingredients', 'notes', 'status', 'category', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && (!('productType' in data) || (data.productType is string && data.productType.size() <= 128))
        && (!('grade' in data) || (data.grade is string && data.grade.size() <= 64))
        && (!('batchSizeKg' in data) || data.batchSizeKg is number)
        && (!('targetCost' in data) || data.targetCost == null || data.targetCost is number)
        && (!('targetPH' in data) || data.targetPH == null || data.targetPH is number)
        && (!('ingredients' in data) || (data.ingredients is list && data.ingredients.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4096))
        && (!('status' in data) || (data.status is string && data.status.size() <= 64))
        && (!('category' in data) || (data.category is string && data.category.size() <= 64));
    }

    function isValidTrial(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'formulaId', 'observations', 'measuredPH', 'measuredViscosityCp', 'stabilityVerdict', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && (!('formulaId' in data) || (data.formulaId is string && data.formulaId.size() <= 128))
        && (!('observations' in data) || (data.observations is string && data.observations.size() <= 8192))
        && (!('measuredPH' in data) || data.measuredPH == null || data.measuredPH is number)
        && (!('measuredViscosityCp' in data) || data.measuredViscosityCp == null || data.measuredViscosityCp is number)
        && (!('stabilityVerdict' in data) || data.stabilityVerdict == null || (data.stabilityVerdict is string && data.stabilityVerdict.size() <= 64));
    }

    // Calibration proposals are per-user lab-evidence records. They were not
    // matched before, so they fell through to the deny-all catch-all and every
    // save/load returned permission-denied.
    // Firestore Rules has no list-wide map/filter operation, so validate each
    // bounded evidence-reference element explicitly (short-circuit guards avoid
    // indexing beyond the supplied list).
    function isStringEvidenceReferenceList(values) {
      return values is list && values.size() <= 50
        && (values.size() <= 0 || values[0] is string)
        && (values.size() <= 1 || values[1] is string)
        && (values.size() <= 2 || values[2] is string)
        && (values.size() <= 3 || values[3] is string)
        && (values.size() <= 4 || values[4] is string)
        && (values.size() <= 5 || values[5] is string)
        && (values.size() <= 6 || values[6] is string)
        && (values.size() <= 7 || values[7] is string)
        && (values.size() <= 8 || values[8] is string)
        && (values.size() <= 9 || values[9] is string)
        && (values.size() <= 10 || values[10] is string)
        && (values.size() <= 11 || values[11] is string)
        && (values.size() <= 12 || values[12] is string)
        && (values.size() <= 13 || values[13] is string)
        && (values.size() <= 14 || values[14] is string)
        && (values.size() <= 15 || values[15] is string)
        && (values.size() <= 16 || values[16] is string)
        && (values.size() <= 17 || values[17] is string)
        && (values.size() <= 18 || values[18] is string)
        && (values.size() <= 19 || values[19] is string)
        && (values.size() <= 20 || values[20] is string)
        && (values.size() <= 21 || values[21] is string)
        && (values.size() <= 22 || values[22] is string)
        && (values.size() <= 23 || values[23] is string)
        && (values.size() <= 24 || values[24] is string)
        && (values.size() <= 25 || values[25] is string)
        && (values.size() <= 26 || values[26] is string)
        && (values.size() <= 27 || values[27] is string)
        && (values.size() <= 28 || values[28] is string)
        && (values.size() <= 29 || values[29] is string)
        && (values.size() <= 30 || values[30] is string)
        && (values.size() <= 31 || values[31] is string)
        && (values.size() <= 32 || values[32] is string)
        && (values.size() <= 33 || values[33] is string)
        && (values.size() <= 34 || values[34] is string)
        && (values.size() <= 35 || values[35] is string)
        && (values.size() <= 36 || values[36] is string)
        && (values.size() <= 37 || values[37] is string)
        && (values.size() <= 38 || values[38] is string)
        && (values.size() <= 39 || values[39] is string)
        && (values.size() <= 40 || values[40] is string)
        && (values.size() <= 41 || values[41] is string)
        && (values.size() <= 42 || values[42] is string)
        && (values.size() <= 43 || values[43] is string)
        && (values.size() <= 44 || values[44] is string)
        && (values.size() <= 45 || values[45] is string)
        && (values.size() <= 46 || values[46] is string)
        && (values.size() <= 47 || values[47] is string)
        && (values.size() <= 48 || values[48] is string)
        && (values.size() <= 49 || values[49] is string);
    }

    function isCalibrationNumber(value) {
      return value is number && value >= -1000000000000 && value <= 1000000000000;
    }

    function isValidCalibrationProposal(data, proposalId) {
      return data.keys().hasAll(['proposalId', 'canonicalCategory', 'kpiId', 'parameterName',
          'proposedShiftOffset', 'observedBias', 'sampleCount', 'meanAbsoluteError',
          'rationale', 'proposedAt', 'status', 'safetyWarning'])
        && data.keys().hasOnly(['proposalId', 'canonicalCategory', 'kpiId', 'parameterName',
          'currentModelParameterValue', 'currentModelValue', 'proposedShiftOffset',
          'proposedCalibratedValue', 'observedBias', 'sampleCount', 'meanAbsoluteError', 'mae',
          'rationale', 'recommendation', 'proposedAt', 'status', 'safetyWarning',
          'evidenceReferenceIds', 'updatedAt'])
        && data.proposalId is string && isValidId(data.proposalId) && data.proposalId == proposalId
        && data.canonicalCategory is string && data.canonicalCategory.size() > 0 && data.canonicalCategory.size() <= 128
        && data.kpiId is string && data.kpiId.size() > 0 && data.kpiId.size() <= 128
        && data.parameterName is string && data.parameterName.size() > 0 && data.parameterName.size() <= 256
        && data.proposedAt is string && data.proposedAt.size() > 0 && data.proposedAt.size() <= 64
        && data.status in ['PROPOSED', 'UNDER_REVIEW', 'REJECTED']
        && data.safetyWarning is string && data.safetyWarning.size() > 0 && data.safetyWarning.size() <= 2000
        && data.rationale is string && data.rationale.size() > 0 && data.rationale.size() <= 8192
        && isCalibrationNumber(data.proposedShiftOffset)
        && isCalibrationNumber(data.observedBias)
        && data.sampleCount is int && data.sampleCount > 0 && data.sampleCount <= 1000000
        && isCalibrationNumber(data.meanAbsoluteError)
        && data.meanAbsoluteError >= 0
        && (!('currentModelParameterValue' in data) || isCalibrationNumber(data.currentModelParameterValue))
        && (!('currentModelValue' in data) || isCalibrationNumber(data.currentModelValue))
        && (!('proposedCalibratedValue' in data) || isCalibrationNumber(data.proposedCalibratedValue))
        && (!('mae' in data) || (isCalibrationNumber(data.mae) && data.mae >= 0))
        && (!('recommendation' in data) || (data.recommendation is string && data.recommendation.size() <= 2000))
        && (!('evidenceReferenceIds' in data) || isStringEvidenceReferenceList(data.evidenceReferenceIds))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64));
    }

    // 4. Match Blocks
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(incoming()) && incoming().id == existing().id;
      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId);

      match /formulas/{formulaId} {
        allow get, delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(formulaId);
        allow list: if (isOwner(userId) || isAdmin()) && isValidId(userId);
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(formulaId) && isValidFormula(incoming(), userId);
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(formulaId) && isValidFormula(incoming(), userId) && incoming().userId == existing().userId;
      }

      match /calibration_proposals/{proposalId} {
        allow get, delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(proposalId);
        allow list: if (isOwner(userId) || isAdmin()) && isValidId(userId);
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(proposalId) && isValidCalibrationProposal(incoming(), proposalId);
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(proposalId) && isValidCalibrationProposal(incoming(), proposalId);
      }

      match /trials/{trialId} {
        allow get, delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(trialId);
        allow list: if (isOwner(userId) || isAdmin()) && isValidId(userId);
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(trialId) && isValidTrial(incoming(), userId);
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(trialId) && isValidTrial(incoming(), userId) && incoming().userId == existing().userId;
      }
    }

    // Firestore connectivity probe. Only this single fixed document is readable,
    // without auth, because the client checks connectivity before sign-in. Every
    // other document under test/ stays denied by the global catch-all.
    match /test/connection {
      allow get: if true;
    }
  }
}
